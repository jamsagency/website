---
import WikiSidebar from '../components/WikiSidebar.astro';
import '@styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const userEmail = Astro.request.headers.get('cf-access-authenticated-user-email');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Jams Wiki</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" is:inline></script>
  </head>
  <body>

    <header class="wiki-header">
      <div class="wiki-header-inner">
        <div class="wiki-header-left">
          <button class="wiki-hamburger" id="menu-toggle" aria-label="Toggle navigation">
            <i class="ph ph-list"></i>
          </button>
          <a href="/wiki" class="wiki-logo-link">
            <img src="/jams-logo-black.svg" alt="Jams" width="120" height="44" style="height:40px; width:auto;" />
            <span class="wiki-label">Wiki</span>
          </a>
        </div>
        {userEmail && (
          <span class="wiki-user-email">{userEmail}</span>
        )}
      </div>
    </header>

    <div class="wiki-body">
      <WikiSidebar currentPath={currentPath} />
      <div id="mobile-overlay" class="mobile-overlay"></div>
      <main class="wiki-main">
        <div class="wiki-content">
          <slot />
        </div>
      </main>
    </div>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const sidebar = document.getElementById('wiki-sidebar');
      const overlay = document.getElementById('mobile-overlay');

      toggle?.addEventListener('click', () => {
        sidebar?.classList.toggle('open');
        overlay?.classList.toggle('active');
        document.body.style.overflow = sidebar?.classList.contains('open') ? 'hidden' : '';
      });

      overlay?.addEventListener('click', () => {
        sidebar?.classList.remove('open');
        overlay?.classList.remove('active');
        document.body.style.overflow = '';
      });
    </script>

  </body>
</html>

<style is:global>
  /* ---- Wiki chrome ---- */

  .wiki-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 57px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .wiki-header-inner {
    height: 100%;
    padding: 0 24px 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wiki-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .wiki-logo-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .wiki-label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    padding: 3px 9px;
    border: 0.5px solid var(--border-soft);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-card), var(--shadow-inset-top);
    line-height: 1.6;
  }

  .wiki-user-email {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--fg-subtle);
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .wiki-hamburger {
    display: none;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    border: 0.5px solid var(--border-soft);
    background: var(--bg-muted);
    box-shadow: var(--shadow-card), var(--shadow-inset-top);
    align-items: center;
    justify-content: center;
    color: var(--fg-muted);
    cursor: pointer;
    font-size: 18px;
  }

  /* ---- Layout ---- */

  .wiki-body {
    display: flex;
    padding-top: 57px;
    min-height: 100vh;
  }

  .wiki-main {
    flex: 1;
    min-width: 0;
    padding: 56px 64px;
  }

  .wiki-content {
    max-width: 720px;
  }

  /* ---- Mobile overlay ---- */

  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 57px 0 0 0;
    background: rgba(0, 0, 0, 0.3);
    z-index: 40;
  }

  .mobile-overlay.active {
    display: block;
  }

  /* ---- Prose ---- */

  .wiki-content h1 {
    font-family: var(--font-sans);
    font-size: 36px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--fg);
    margin-bottom: 10px;
  }

  .wiki-content h1 + p {
    font-size: 15px;
    color: var(--fg-subtle);
    line-height: 1.6;
    margin-bottom: 20px;
    letter-spacing: -0.01em;
  }

  .wiki-content h2 {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-top: 52px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .wiki-content h3 {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--fg);
    margin-top: 28px;
    margin-bottom: 8px;
  }

  .wiki-content p {
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--fg-muted);
    margin-bottom: 16px;
  }

  .wiki-content p em {
    color: var(--fg-subtle);
    font-style: italic;
    font-size: 15px;
  }

  .wiki-content ul,
  .wiki-content ol {
    padding-left: 22px;
    margin-bottom: 16px;
  }

  .wiki-content li {
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--fg-muted);
    margin-bottom: 5px;
  }

  .wiki-content ul > li::marker {
    color: var(--orange);
  }

  .wiki-content li input[type="checkbox"] {
    margin-right: 8px;
    accent-color: var(--orange);
  }

  .wiki-content strong {
    font-weight: 600;
    color: var(--fg);
  }

  .wiki-content code {
    font-family: 'Geist Mono', 'SF Mono', monospace;
    font-size: 13.5px;
    background: var(--bg-muted);
    border: 0.5px solid var(--border-soft);
    border-radius: var(--radius-xs);
    padding: 2px 6px;
    color: var(--fg);
  }

  .wiki-content pre {
    background: var(--bg-muted);
    border: 0.5px solid var(--border-soft);
    border-radius: var(--radius-sm);
    padding: 20px 24px;
    overflow-x: auto;
    margin-bottom: 20px;
  }

  .wiki-content pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: 13.5px;
    line-height: 1.6;
  }

  .wiki-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
    font-family: var(--font-sans);
    font-size: 15px;
  }

  .wiki-content th {
    text-align: left;
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
  }

  .wiki-content td {
    padding: 12px 16px;
    color: var(--fg-muted);
    border-bottom: 0.5px solid var(--border-soft);
    vertical-align: top;
    line-height: 1.55;
  }

  .wiki-content tr:last-child td {
    border-bottom: none;
  }

  .wiki-content hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 40px 0;
  }

  .wiki-content a {
    color: var(--orange);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .wiki-content a:hover {
    color: var(--orange-hover);
  }

  /* ---- Responsive ---- */

  @media (max-width: 992px) {
    .wiki-hamburger { display: flex; }
    .wiki-main { padding: 40px 32px; }
  }

  @media (max-width: 480px) {
    .wiki-main { padding: 28px 20px; }
    .wiki-content h1 { font-size: 28px; }
    .wiki-content h2 { font-size: 19px; }
  }
</style>
