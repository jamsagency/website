---
import BaseLayout from './BaseLayout.astro';
import CTASection from '@components/CTASection.astro';

interface Props {
  title: string;
  description: string;
  projectName: string;
  tags: string[];
  headline?: string;
  intro?: string;
  heroImage?: string;
  heroImageAlt?: string;
  schema?: object;
}

const { title, description, projectName, tags, headline, intro, heroImage, heroImageAlt, schema } = Astro.props;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://jams.agency' },
    { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://jams.agency/work' },
    { '@type': 'ListItem', position: 3, name: projectName },
  ],
};
---

<BaseLayout {title} {description} schema={schema ?? breadcrumbSchema}>
<style is:global>
  /* Case study hero: reduce padding on mobile */
  .case-hero-inner {
    padding-top: 120px;
    padding-bottom: 64px;
  }
  @media (max-width: 768px) {
    .case-hero-inner {
      padding-top: 80px;
      padding-bottom: 40px;
    }
  }

  /* Tech stack dl grid: 2-col → 1-col on mobile */
  @media (max-width: 480px) {
    .case-study-dl {
      grid-template-columns: 1fr !important;
    }
  }

  /* Dark stat box: reduce padding on mobile */
  @media (max-width: 480px) {
    .case-stat-box {
      padding: 32px 24px !important;
    }
  }
</style>

  <!-- Internal hero -->
  <section class="hero-bg overflow-hidden">
    <div class="container case-hero-inner">
      <div class="flex flex-col gap-6">
        <!-- Tags -->
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => <span class="chip">{tag}</span>)}
        </div>
        {headline && (
          <div class="flex flex-col gap-4 pt-2">
            <h1 class="font-display text-h1 text-neutral-900 max-w-3xl">{headline}</h1>
            {intro && <p class="font-sans text-p-l text-neutral-600 max-w-2xl">{intro}</p>}
          </div>
        )}
      </div>
    </div>
    <!-- Hero image: full width, flush to bottom edge -->
    {heroImage && (
      <img
        src={heroImage}
        alt={heroImageAlt ?? projectName}
        width="1240"
        height="700"
        class="w-full h-auto block"
        loading="eager"
      />
    )}
  </section>

  <!-- Page content -->
  <slot />

  <CTASection />
</BaseLayout>
