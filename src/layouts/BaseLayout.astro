---
import SEOHead from '@components/SEOHead.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import PostHog from '@components/posthog.astro';
import '@styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  schema?: object;
  noindex?: boolean;
}

const { title, description, ogImage, canonical, schema, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonical={canonical}
      schema={schema}
      noindex={noindex}
    />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z2C8B7RQML" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Z2C8B7RQML');
    </script>

    <!-- CookieScript -->
    <script type="text/javascript" charset="UTF-8" src="//cdn.cookie-script.com/s/0db8833d239ed21663ca98c366090114.js" is:inline></script>

    <!-- RB2B -->
    <script is:inline>!function(key) {if (window.reb2b) return;window.reb2b = {loaded: true};var s = document.createElement("script");s.async = true;s.src = "https://b2bjsstore.s3.us-west-2.amazonaws.com/b/" + key + "/" + key + ".js.gz";document.getElementsByTagName("script")[0].parentNode.insertBefore(s, document.getElementsByTagName("script")[0]);}("9NMMZHPVVRNW");</script>

    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" is:inline></script>
    <script src="https://unpkg.com/lucide@latest" is:inline></script>

    <PostHog />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>lucide.createIcons();</script>
  </body>
</html>
