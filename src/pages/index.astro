<script is:inline>
(function () {
  var vid = document.getElementById('hero-video');
  if (!vid) return;

  var playBtn = document.getElementById('hero-play-btn');
  var iconPause = document.getElementById('hero-icon-pause');
  var iconPlay  = document.getElementById('hero-icon-play');
  var volBtn = document.getElementById('hero-vol-btn');
  var iconVolOn  = document.getElementById('hero-icon-vol-on');
  var iconVolOff = document.getElementById('hero-icon-vol-off');
  var volSlider = document.getElementById('hero-vol-slider');
  var progressBar = document.getElementById('hero-progress');
  var progressFill = document.getElementById('hero-progress-fill');
  var centerPlay = document.getElementById('hero-center-play');
  var controlsBar = document.getElementById('hero-controls-bar');
  var topScrim = document.getElementById('hero-top-scrim');

  function setPlayingState(playing) {
    centerPlay.style.opacity = playing ? '0' : '1';
    centerPlay.style.pointerEvents = playing ? 'none' : 'all';
    controlsBar.style.opacity = playing ? '1' : '0';
    controlsBar.style.pointerEvents = playing ? 'all' : 'none';
    topScrim.style.opacity = playing ? '1' : '0';
    iconPause.style.display = playing ? '' : 'none';
    iconPlay.style.display  = playing ? 'none' : '';
  }

  // Center play button + clicking the video itself
  centerPlay.addEventListener('click', function () { vid.play(); });
  vid.addEventListener('click', function () { vid.paused ? vid.play() : vid.pause(); });

  // Play/pause button in controls bar
  playBtn.addEventListener('click', function () { vid.paused ? vid.play() : vid.pause(); });

  vid.addEventListener('play', function () { setPlayingState(true); });
  vid.addEventListener('pause', function () { setPlayingState(false); });

  // Volume slider
  volSlider.addEventListener('input', function () {
    vid.volume = parseFloat(volSlider.value);
    vid.muted = vid.volume === 0;
    updateVolIcon();
  });

  // Mute toggle
  volBtn.addEventListener('click', function () {
    vid.muted = !vid.muted;
    if (!vid.muted && vid.volume === 0) { vid.volume = 0.7; }
    updateVolIcon();
  });

  function updateVolIcon() {
    var muted = vid.muted || vid.volume === 0;
    iconVolOn.style.display  = muted ? 'none' : '';
    iconVolOff.style.display = muted ? '' : 'none';
    volSlider.value = muted ? 0 : vid.volume;
  }

  // Progress
  vid.addEventListener('timeupdate', function () {
    if (vid.duration) progressFill.style.width = (vid.currentTime / vid.duration * 100) + '%';
  });

  progressBar.addEventListener('click', function (e) {
    var rect = progressBar.getBoundingClientRect();
    var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
    if (vid.duration) vid.currentTime = pct * vid.duration;
  });
})();
</script>
</body>
</html>
