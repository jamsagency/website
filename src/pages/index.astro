---
import SEOHead from '@components/SEOHead.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import CTASection from '@components/CTASection.astro';
import '@styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
  <SEOHead
    title="Jams: Custom AI and software for founders"
    description="We figure out what your business actually needs first. Then we build it. The product team for businesses that don't have one."
  />
  <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" is:inline></script>
  <script src="https://unpkg.com/lucide@latest" is:inline></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; font-family: var(--font-sans); color: #111; background: #fff; -webkit-font-smoothing: antialiased; }
    h1, h2, h3, h4, h5, h6 { font-family: var(--font-sans); }
    @media (max-width: 768px) { .desktop-br { display: none; } }

    /* Hero responsive — 991px and below: video first, copy below */
    @media (max-width: 991px) {
      .hero-grid {
        display: flex !important;
        flex-direction: column;
        align-items: flex-start;
        gap: 40px;
        padding-bottom: 64px;
      }
      .hero-grid > div:first-child {
        width: 100%;
        order: 2;
      }
      .hero-liquid-card {
        order: 1;
        max-width: 300px;
        width: 100%;
      }
    }

    /* Hero video card — center on small screens */
    @media (max-width: 480px) {
      .hero-liquid-card {
        align-self: center;
      }
    }

    /* Liquid glass hero card — prevent overflow on mobile */
    @media (max-width: 768px) {
      .hero-liquid-card {
        padding: 24px 20px 32px !important;
      }
      .hero-grid .hero-liquid-card {
        padding: 0 !important;
      }
    }

    /* Hero body text — slightly smaller on mobile */
    @media (max-width: 480px) {
      .hero-body-text {
        font-size: 18px !important;
      }
    }

    .client-logos {
      display: flex;
      align-items: center;
      gap: 48px;
      flex-wrap: wrap;
    }
    @media (max-width: 480px) {
      .client-logos {
        gap: 28px;
      }
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      padding: 0 24px;
    }
    @media (max-width: 768px) {
      .testimonials-grid {
        grid-template-columns: 1fr;
        gap: 32px;
        padding: 0;
      }
    }

    .why-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    @media (max-width: 768px) {
      .why-grid {
        grid-template-columns: 1fr;
      }
      .why-grid > div[style*="border-right"] {
        border-right: none !important;
        border-bottom: 1px solid rgba(255,255,255,0.1);
      }
    }

    .process-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 20px;
      align-items: stretch;
    }
    @media (max-width: 768px) {
      .process-grid {
        grid-template-columns: 1fr;
      }
    }

    .cases-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 48px;
      gap: 40px;
    }
    @media (max-width: 768px) {
      .cases-header {
        flex-direction: column;
        gap: 16px;
      }
    }

    .cases-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    @media (max-width: 768px) {
      .cases-grid {
        grid-template-columns: 1fr;
      }
    }

.credentials-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
    }
    .trusted-by-group {
      display: flex;
      align-items: center;
      gap: 22px;
    }
    @media (max-width: 768px) {
      .credentials-bar {
        flex-direction: column;
        align-items: center;
        height: auto;
        gap: 24px;
      }
      .trusted-by-group {
        flex-direction: column;
        align-items: center;
        gap: 16px;
      }
      .trusted-by-label {
        width: auto !important;
        text-align: center;
      }
      .client-logos {
        justify-content: center;
        gap: 28px;
      }
    }
    .cta-btn {
      display: inline-block;
      background: #fff;
      color: #111;
      padding: 14px 36px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 700;
      text-decoration: none;
      transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 120ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .cta-btn:hover {
      transform: scale(1.04);
      box-shadow: 0 8px 24px rgba(0,0,0,0.18);
    }
    .link-btn {
      display: inline-block;
      color: #F55D11;
      border: 1.5px solid rgba(245,93,17,0.35);
      background: transparent;
      padding: 9px 16px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: border-color 120ms cubic-bezier(0.22, 1, 0.36, 1), background 120ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .link-btn:hover {
      border-color: #F55D11;
      background: rgba(245,93,17,0.06);
    }

    .hn-container {
      max-width: 1280px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 48px;
      padding-right: 48px;
    }

    /* --- Sticky notes --- */
    .sticky-board {
      position: relative;
      height: 500px;
      background:
        radial-gradient(circle, #C8C8C8 1.5px, transparent 1.5px),
        #fff;
      background-size: 24px 24px, 100% 100%;
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.08), 0 1px 4px rgba(0,0,0,0.04);
    }
    .sticky {
      position: absolute;
      background: #F9AA43;
      padding: 14px 16px;
      border-radius: 4px;
      font-size: 15px;
      font-weight: 500;
      line-height: 1.45;
      color: #111;
      box-shadow: 2px 3px 8px rgba(0,0,0,0.1);
      max-width: 210px;
    }

    /* --- CTA image section --- */
    .hn-cta-section {
      padding: 128px 24px;
      background: url('/cta-bg.jpg') center center / cover no-repeat;
    }
    .hn-cta-card {
      max-width: 820px;
      margin: 0 auto;
      background: rgba(255, 255, 255, 0.10);
      backdrop-filter: blur(32px) saturate(160%);
      -webkit-backdrop-filter: blur(32px) saturate(160%);
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.22);
      box-shadow:
        0 8px 40px rgba(0, 0, 0, 0.25),
        inset 0 1.5px 0 rgba(255, 255, 255, 0.35),
        inset 0 -1px 0 rgba(255, 255, 255, 0.1);
      padding: 72px 56px;
      text-align: center;
    }

    /* --- Testimonial sticky --- */
    .testimonial-sticky {
      background: #F9AA43;
      padding: 32px;
      border-radius: 4px;
      box-shadow: 3px 4px 12px rgba(0,0,0,0.1);
    }

    /* --- Sticky CTA button --- */
    .sticky-cta {
      position: absolute;
      left: 28px;
      right: 28px;
      bottom: -18px;
      display: block;
      background: #F9AA43;
      color: #111;
      padding: 11px 16px;
      border-radius: 4px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      text-align: center;
      transform: rotate(-2.5deg);
      box-shadow: 2px 4px 12px rgba(0,0,0,0.13), 0 1px 3px rgba(0,0,0,0.07);
      transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 120ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .sticky-cta:hover {
      transform: rotate(-2.5deg) scale(1.04);
      box-shadow: 3px 6px 18px rgba(0,0,0,0.16), 0 2px 5px rgba(0,0,0,0.09);
    }

    /* --- Nav --- */
    .hn-nav {
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      padding: 8px 24px;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
    }
    .hn-nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
    }
    .hn-nav-logo {
      display: flex;
      align-items: center;
      gap: 0;
      text-decoration: none;
      color: inherit;
      flex-shrink: 0;
    }
    .hn-nav-tagline {
      font-size: 16px;
      font-weight: 400;
      letter-spacing: -0.01em;
      color: #0F1112;
      line-height: 1;
      white-space: nowrap;
      margin-left: -3px;
      position: relative;
      top: 1px;
    }
    .hn-nav-links {
      display: flex;
      align-items: center;
      gap: 32px;
      flex-shrink: 0;
    }
    .hn-nav-links a {
      font-size: 16px;
      font-weight: 400;
      letter-spacing: -0.01em;
      color: #0F1112;
      text-decoration: none;
      position: relative;
      transition: color 0.12s;
    }
    .hn-nav-links a:not(.hn-btn-orange)::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: #0F1112;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity 200ms cubic-bezier(0.22, 1, 0.36, 1), transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .hn-nav-links a:not(.hn-btn-orange):hover::after {
      opacity: 1;
      transform: translateY(0);
    }
    .hn-nav-links a:hover { color: #0F1112; }
    .hn-btn-orange {
      background: #F55D11;
      color: #fff !important;
      padding: 12px 20px;
      width: 130px;
      border-radius: 8px;
      font-size: 18px;
      font-weight: 500 !important;
      white-space: nowrap;
      position: relative;
      overflow: hidden;
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      transition: background 0.12s !important;
    }
    .hn-btn-arrow {
      position: absolute;
      left: 10px;
      width: 16px;
      height: 16px;
      opacity: 0;
      transform: translateX(-6px);
      transition: opacity 200ms cubic-bezier(0.22, 1, 0.36, 1), transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
      stroke: #fff;
    }
    .hn-btn-orange span {
      display: inline-block;
      transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .hn-btn-orange:hover { background: #D94D0A !important; color: #fff !important; }
    .hn-btn-orange:hover .hn-btn-arrow { opacity: 1; transform: translateX(0); }
    .hn-btn-orange:hover span { transform: translateX(6px); }

    /* --- Sticky note CTA button --- */
    .sticky-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      align-self: stretch;
      background: #F9AA43;
      color: #111;
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 18px;
      font-weight: 500;
      letter-spacing: -0.01em;
      text-decoration: none;
      transform: rotate(-1deg);
      box-shadow: 2px 5px 14px rgba(0,0,0,0.12), 0 1px 3px rgba(0,0,0,0.06);
      transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 200ms cubic-bezier(0.22, 1, 0.36, 1);
      margin-top: 8px;
    }
    .sticky-btn:hover {
      transform: rotate(-1deg) scale(1.01);
      box-shadow: 3px 10px 24px rgba(0,0,0,0.16), 0 2px 6px rgba(0,0,0,0.08);
    }
    .sticky-btn-arrow {
      width: 0;
      height: 16px;
      opacity: 0;
      overflow: hidden;
      flex-shrink: 0;
      stroke: #111;
      margin-right: 0;
      transition: width 200ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms cubic-bezier(0.22, 1, 0.36, 1), margin-right 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .sticky-btn > span {
      display: inline-block;
    }
    .sticky-btn:hover .sticky-btn-arrow { width: 16px; opacity: 1; margin-right: 6px; }

    /* --- Read link (underline style with hover arrow) --- */
    .read-link {
      display: inline-flex;
      align-items: center;
      position: relative;
      font-size: 16px;
      font-weight: 400;
      letter-spacing: -0.01em;
      color: #0F1112;
      text-decoration: none;
    }
    .read-link::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 100%;
      height: 1px;
      background: #0F1112;
    }
    .read-link-arrow {
      width: 0;
      height: 14px;
      opacity: 0;
      overflow: hidden;
      flex-shrink: 0;
      stroke: #0F1112;
      margin-right: 0;
      transition: width 200ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms cubic-bezier(0.22, 1, 0.36, 1), margin-right 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .read-link > span {
      display: inline-block;
      transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .read-link:hover .read-link-arrow { width: 14px; opacity: 1; margin-right: 1px; }
    .read-link:hover > span { transform: translateX(4px); }

    /* --- Footer links --- */
    .hn-footer-link {
      font-size: 15px;
      font-weight: 400;
      color: #111;
      text-decoration: none;
      position: relative;
      width: fit-content;
      transition: color 0.12s;
    }
    .hn-footer-link::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 100%;
      height: 1px;
      background: #111;
      opacity: 0;
      transform: translateY(3px);
      transition: opacity 200ms cubic-bezier(0.22,1,0.36,1), transform 200ms cubic-bezier(0.22,1,0.36,1);
    }
    .hn-footer-link:hover::after { opacity: 1; transform: translateY(0); }

    .hn-footer-submit {
      background: transparent;
      color: #111;
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 500;
      border: 1px solid rgba(0,0,0,0.18);
      cursor: pointer;
      white-space: nowrap;
      font-family: inherit;
      position: relative;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background 0.12s cubic-bezier(0.22,1,0.36,1), border-color 0.12s cubic-bezier(0.22,1,0.36,1);
    }
    .hn-footer-submit .hn-btn-arrow { stroke: #111; }
    .hn-footer-submit span {
      display: inline-block;
      transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .hn-footer-submit:hover { background: rgba(0,0,0,0.05); border-color: rgba(0,0,0,0.28); }
    .hn-footer-submit:hover .hn-btn-arrow { opacity: 1; transform: translateX(0); }
    .hn-footer-submit:hover span { transform: translateX(8px); }

    .hn-email-input {
      flex: 1;
      max-width: 280px;
      padding: 12px 16px;
      border: 1px solid #DDDDD8;
      border-radius: 8px;
      font-size: 15px;
      font-family: inherit;
      color: #111;
      background: #fff;
      outline: none;
      transition: border-color 200ms cubic-bezier(0.22,1,0.36,1), box-shadow 200ms cubic-bezier(0.22,1,0.36,1);
    }
    .hn-email-input:hover,
    .hn-email-input:focus {
      border-color: #888;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
    }

    .hn-contact-link {
      color: #111;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color 200ms cubic-bezier(0.22,1,0.36,1);
    }
    .hn-contact-link:hover { color: #F55D11; }

    /* --- Hero video center play button --- */
    #hero-center-play:hover {
      transform: scale(1.08);
      background: #E8980A !important;
    }

    /* --- Hero video controls --- */
    .hero-video-controls input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      width: 56px;
      height: 3px;
      background: rgba(255,255,255,0.35);
      border-radius: 999px;
      outline: none;
      cursor: pointer;
      flex-shrink: 0;
    }
    .hero-video-controls input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: #fff;
      cursor: pointer;
    }
    .hero-video-controls input[type="range"]::-moz-range-thumb {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: #fff;
      border: none;
      cursor: pointer;
    }

    /* --- Liquid glass card --- */
    .liquid-glass {
      position: relative;
      background: rgba(255, 255, 255, 0.38);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.7);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.08),
        inset 0 1.5px 0 rgba(255, 255, 255, 0.9),
        inset 0 -1px 0 rgba(255, 255, 255, 0.25),
        inset 1px 0 0 rgba(255, 255, 255, 0.5),
        inset -1px 0 0 rgba(255, 255, 255, 0.5);
      overflow: hidden;
    }
    .liquid-glass::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.28) 0%,
        rgba(255, 255, 255, 0.06) 50%,
        rgba(180, 160, 255, 0.06) 100%
      );
      pointer-events: none;
    }
  </style>
</head>
<body>

<Nav />

<!-- ===== HERO ===== -->
<section class="hero-no-bottom-pad" style="background: radial-gradient(circle, #DCDCDE 1.5px, transparent 1.5px) 0 0 / 24px 24px, linear-gradient(in oklab 180deg, oklab(100% 0 0) 14%, oklab(84.3% 0.005 -0.016) 120%); padding: 80px 24px 0; margin-top: 65px;">
  <div class="hn-container">
    <div class="hero-grid" style="grid-template-columns: 4fr 2fr;">

      <!-- Left: copy -->
      <div style="display: flex; flex-direction: column; gap: 28px; padding-top: 8px;">
        <h1 style="font-size: clamp(32px, 3.8vw, 56px); font-weight: 500; line-height: 1.05; letter-spacing: -0.025em; color: #111; margin: 0;">
          Stop hiring software teams that promise the world and ship excuses.
        </h1>
        <p style="font-size: 20px; line-height: 1.4; letter-spacing: -0.01em; color: #000; margin: 0; max-width: 560px;">
          We bill less when we under-deliver. Try finding another software agency that does that.
        </p>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px;">
          <li style="display: flex; align-items: baseline; gap: 10px; font-size: 17px; line-height: 1.5; letter-spacing: -0.01em; color: #000;">
            <span style="color: #F55D11; font-size: 20px; line-height: 0.9; flex-shrink: 0;">•</span>
            Skin-in-the-game pricing where both sides win
          </li>
          <li style="display: flex; align-items: baseline; gap: 10px; font-size: 17px; line-height: 1.5; letter-spacing: -0.01em; color: #000;">
            <span style="color: #F55D11; font-size: 20px; line-height: 0.9; flex-shrink: 0;">•</span>
            Custom web and mobile apps with built-in AI, not AI wrappers
          </li>
          <li style="display: flex; align-items: baseline; gap: 10px; font-size: 17px; line-height: 1.5; letter-spacing: -0.01em; color: #000;">
            <span style="color: #F55D11; font-size: 20px; line-height: 0.9; flex-shrink: 0;">•</span>
            US company with South American team that speaks native English
          </li>
          <li style="display: flex; align-items: baseline; gap: 10px; font-size: 17px; line-height: 1.5; letter-spacing: -0.01em; color: #000;">
            <span style="color: #F55D11; font-size: 20px; line-height: 0.9; flex-shrink: 0;">•</span>
            18 months average customer retention
          </li>
          <li style="display: flex; align-items: baseline; gap: 10px; font-size: 17px; line-height: 1.5; letter-spacing: -0.01em; color: #000;">
            <span style="color: #F55D11; font-size: 20px; line-height: 0.9; flex-shrink: 0;">•</span>
            Regular visits to the US and Canada for in-person strategy and bonding
          </li>
        </ul>
        <!-- CTAs -->
        <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center;">
          <a href="/start" class="sticky-btn" style="margin-top: 0; align-self: auto;">
            <i data-lucide="arrow-right" class="sticky-btn-arrow"></i>
            <span>Book a call</span>
          </a>
          <a href="/start" class="read-link">
            <i data-lucide="arrow-right" class="read-link-arrow"></i>
            <span>See how our skin-in-the-game pricing works</span>
          </a>
        </div>
        <!-- Trust bar -->
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="display: flex; align-items: center; flex-shrink: 0;">
            <img src="/spencer-richardson.jpeg" alt="Spencer Richardson" width="32" height="32" style="width: 32px; height: 32px; border-radius: 999px; object-fit: cover; border: 2px solid #fff; position: relative; z-index: 5;" />
            <img src="/neill-etheridge.jpeg" alt="Neill Etheridge" width="32" height="32" style="width: 32px; height: 32px; border-radius: 999px; object-fit: cover; border: 2px solid #fff; margin-left: -8px; position: relative; z-index: 4;" />
            <img src="/don-britton.jpeg" alt="Don Britton" width="32" height="32" style="width: 32px; height: 32px; border-radius: 999px; object-fit: cover; border: 2px solid #fff; margin-left: -8px; position: relative; z-index: 3;" />
            <img src="/davis-warren.jpg" alt="Davis Warren" width="32" height="32" style="width: 32px; height: 32px; border-radius: 999px; object-fit: cover; border: 2px solid #fff; margin-left: -8px; position: relative; z-index: 2;" />
            <img src="/nicolas-tanos.jpeg" alt="Nicolas Tanos" width="32" height="32" style="width: 32px; height: 32px; border-radius: 999px; object-fit: cover; border: 2px solid #fff; margin-left: -8px; position: relative; z-index: 1;" />
