---
import SEOHead from '@components/SEOHead.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import CTASection from '@components/CTASection.astro';
import '@styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
  <SEOHead
    title="Jams: Custom AI and software for founders"
    description="We figure out what your business actually needs first. Then we build it. The product team for businesses that don't have one."
  />
  <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" is:inline></script>
  <script src="https://unpkg.com/lucide@latest" is:inline></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; font-family: var(--font-sans); color: #111; background: #fff; -webkit-font-smoothing: antialiased; }
    h1, h2, h3, h4, h5, h6 { font-family: var(--font-sans); }
    @media (max-width: 768px) { .desktop-br { display: none; } }

    /* Liquid glass hero card — prevent overflow on mobile */
    @media (max-width: 768px) {
      .hero-liquid-card {
        padding: 24px 20px 32px !important;
      }
    }

    /* Hero body text — slightly smaller on mobile */
    @media (max-width: 480px) {
      .hero-body-text {
        font-size: 18px !important;
      }
    }

    .client-logos {
      display: flex;
      align-items: center;
      gap: 48px;
      flex-wrap: wrap;
    }
    @media (max-width: 480px) {
      .client-logos {
        gap: 28px;
      }
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      padding: 0 24px;
    }
    @media (max-width: 768px) {
      .testimonials-grid {
        grid-template-columns: 1fr;
        gap: 32px;
        padding: 0;
      }
    }

    .why-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    @media (max-width: 768px) {
      .why-grid {
        grid-template-columns: 1fr;
      }
      .why-grid > div[style*="border-right"] {
        border-right: none !important;
        border-bottom: 1px solid rgba(255,255,255,0.1);
      }
    }

    .process-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 20px;
      align-items: stretch;
    }
    @media (max-width: 768px) {
      .process-grid {
        grid-template-columns: 1fr;
      }
    }

    .cases-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 48px;
      gap: 40px;
    }
    @media (max-width: 768px) {
      .cases-header {
        flex-direction: column;
        gap: 16px;
      }
    }

    .cases-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    @media (max-width: 768px) {
      .cases-grid {
        grid-template-columns: 1fr;
      }
    }

.credentials-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
    }
    .trusted-by-group {
      display: flex;
      align-items: center;
      gap: 22px;
    }
    @media (max-width: 768px) {
      .credentials-bar {
        flex-direction: column;
        align-items: center;
        height: auto;
        gap: 24px;
      }
      .trusted-by-group {
        flex-direction: column;
        align-items: center;
        gap: 16px;
      }
      .trusted-by-label {
        width: auto !important;
        text-align: center;
      }
      .client-logos {
        justify-content: center;
        gap: 28px;
      }
    }
    .cta-btn {
      display: inline-block;
      background: #fff;
      color: #111;
      padding: 14px 36px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 700;
      text-decoration: none;
      transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 120ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .cta-btn:hover {
      transform: scale(1.04);
      box-shadow: 0 8px 24px rgba(0,0,0,0.18);
    }
    .link-btn {
      display: inline-block;
      color: #F55D11;
      border: 1.5px solid rgba(245,93,17,0.35);
      background: transparent;
      padding: 9px 16px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: border-color 120ms cubic-bezier(0.22, 1, 0.36, 1), background 120ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .link-btn:hover {
      border-color: #F55D11;
      background: rgba(245,93,17,0.06);
    }

    .hn-container {
      max-width: 1280px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 48px;
      padding-right: 48px;
    }

    /* --- Sticky notes --- */
    .sticky-board {
      position: relative;
      height: 500px;
      background:
        radial-gradient(circle, #C8C8C8 1.5px, transparent 1.5px),
        #fff;
      background-size: 24px 24px, 100% 100%;
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.08), 0 1px 4px rgba(0,0,0,0.04);
    }
    .sticky {
      position: absolute;
      background: #F9AA43;
      padding: 14px 16px;
      border-radius: 4px;
      font-size: 15px;
      font-weight: 500;
      line-height: 1.45;
      color: #111;
      box-shadow: 2px 3px 8px rgba(0,0,0,0.1);
      max-width: 210px;
    }

    /* --- CTA image section --- */
    .hn-cta-section {
      padding: 128px 24px;
      background: url('/cta-bg.jpg') center center / cover no-repeat;
    }
    .hn-cta-card {
      max-width: 820px;
      margin: 0 auto;
      background: rgba(255, 255, 255, 0.10);
      backdrop-filter: blur(32px) saturate(160%);
      -webkit-backdrop-filter: blur(32px) saturate(160%);
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.22);
      box-shadow:
        0 8px 40px rgba(0, 0, 0, 0.25),
        inset 0 1.5px 0 rgba(255, 255, 255, 0.35),
        inset 0 -1px 0 rgba(255, 255, 255, 0.1);
      padding: 72px 56px;
      text-align: center;
    }

    /* --- Testimonial sticky --- */
    .testimonial-sticky {
      background: #F9AA43;
      padding: 32px;
      border-radius: 4px;
      box-shadow: 3px 4px 12px rgba(0,0,0,0.1);
    }

    /* --- Sticky CTA button --- */
    .sticky-cta {
      position: absolute;
      left: 28px;
      right: 28px;
      bottom: -18px;
      display: block;
      background: #F9AA43;
      color: #111;
      padding: 11px 16px;
      border-radius: 4px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      text-align: center;
      transform: rotate(-2.5deg);
      box-shadow: 2px 4px 12px rgba(0,0,0,0.13), 0 1px 3px rgba(0,0,0,0.07);
      transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 120ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .sticky-cta:hover {
      transform: rotate(-2.5deg) scale(1.04);
      box-shadow: 3px 6px 18px rgba(0,0,0,0.16), 0 2px 5px rgba(0,0,0,0.09);
    }

    /* --- Nav --- */
    .hn-nav {
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      padding: 8px 24px;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
    }
    .hn-nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
    }
    .hn-nav-logo {
      display: flex;
      align-items: center;
      gap: 0;
      text-decoration: none;
      color: inherit;
      flex-shrink: 0;
    }
    .hn-nav-tagline {
      font-size: 16px;
      font-weight: 400;
      letter-spacing: -0.01em;
      color: #0F1112;
      line-height: 1;
      white-space: nowrap;
      margin-left: -3px;
      position: relative;
      top: 1px;
    }
    .hn-nav-links {
      display: flex;
      align-items: center;
      gap: 32px;
      flex-shrink: 0;
    }
    .hn-nav-links a {
      font-size: 16px;
      font-weight: 400;
      letter-spacing: -0.01em;
      color: #0F1112;
      text-decoration: none;
      position: relative;
      transition: color 0.12s;
    }
    .hn-nav-links a:not(.hn-btn-orange)::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: #0F1112;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity 200ms cubic-bezier(0.22, 1, 0.36, 1), transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .hn-nav-links a:not(.hn-btn-orange):hover::after {
      opacity: 1;
      transform: translateY(0);
    }
    .hn-nav-links a:hover { color: #0F1112; }
    .hn-btn-orange {
      background: #F55D11;
      color: #fff !important;
      padding: 12px 20px;
      width: 130px;
      border-radius: 8px;
      font-size: 18px;
      font-weight: 500 !important;
      white-space: nowrap;
      position: relative;
      overflow: hidden;
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      transition: background 0.12s !important;
    }
    .hn-btn-arrow {
      position: absolute;
      left: 10px;
      width: 16px;
      height: 16px;
      opacity: 0;
      transform: translateX(-6px);
      transition: opacity 200ms cubic-bezier(0.22, 1, 0.36, 1), transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
      stroke: #fff;
    }
    .hn-btn-orange span {
      display: inline-block;
      transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .hn-btn-orange:hover { background: #D94D0A !important; color: #fff !important; }
    .hn-btn-orange:hover .hn-btn-arrow { opacity: 1; transform: translateX(0); }
    .hn-btn-orange:hover span { transform: translateX(6px); }

    /* --- Sticky note CTA button --- */
    .sticky-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      align-self: stretch;
      background: #F9AA43;
      color: #111;
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 18px;
      font-weight: 500;
      letter-spacing: -0.01em;
      text-decoration: none;
      transform: rotate(-1deg);
      box-shadow: 2px 5px 14px rgba(0,0,0,0.12), 0 1px 3px rgba(0,0,0,0.06);
      transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 200ms cubic-bezier(0.22, 1, 0.36, 1);
      margin-top: 8px;
    }
    .sticky-btn:hover {
      transform: rotate(-1deg) scale(1.01);
      box-shadow: 3px 10px 24px rgba(0,0,0,0.16), 0 2px 6px rgba(0,0,0,0.08);
    }
    .sticky-btn-arrow {
      width: 0;
      height: 16px;
      opacity: 0;
      overflow: hidden;
      flex-shrink: 0;
      stroke: #111;
      margin-right: 0;
      transition: width 200ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms cubic-bezier(0.22, 1, 0.36, 1), margin-right 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .sticky-btn > span {
      display: inline-block;
    }
    .sticky-btn:hover .sticky-btn-arrow { width: 16px; opacity: 1; margin-right: 6px; }

    /* --- Read link (underline style with hover arrow) --- */
    .read-link {
      display: inline-flex;
      align-items: center;
      position: relative;
      font-size: 16px;
      font-weight: 400;
      letter-spacing: -0.01em;
      color: #0F1112;
      text-decoration: none;
    }
    .read-link::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 100%;
      height: 1px;
      background: #0F1112;
    }
    .read-link-arrow {
      width: 0;
      height: 14px;
      opacity: 0;
      overflow: hidden;
      flex-shrink: 0;
      stroke: #0F1112;
      margin-right: 0;
      transition: width 200ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms cubic-bezier(0.22, 1, 0.36, 1), margin-right 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .read-link > span {
      display: inline-block;
      transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .read-link:hover .read-link-arrow { width: 14px; opacity: 1; margin-right: 1px; }
    .read-link:hover > span { transform: translateX(4px); }

    /* --- Footer links --- */
    .hn-footer-link {
      font-size: 15px;
      font-weight: 400;
      color: #111;
      text-decoration: none;
      position: relative;
      width: fit-content;
      transition: color 0.12s;
    }
    .hn-footer-link::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 100%;
      height: 1px;
      background: #111;
      opacity: 0;
      transform: translateY(3px);
      transition: opacity 200ms cubic-bezier(0.22,1,0.36,1), transform 200ms cubic-bezier(0.22,1,0.36,1);
    }
    .hn-footer-link:hover::after { opacity: 1; transform: translateY(0); }

    .hn-footer-submit {
      background: transparent;
      color: #111;
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 500;
      border: 1px solid rgba(0,0,0,0.18);
      cursor: pointer;
      white-space: nowrap;
      font-family: inherit;
      position: relative;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background 0.12s cubic-bezier(0.22,1,0.36,1), border-color 0.12s cubic-bezier(0.22,1,0.36,1);
    }
    .hn-footer-submit .hn-btn-arrow { stroke: #111; }
    .hn-footer-submit span {
      display: inline-block;
      transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .hn-footer-submit:hover { background: rgba(0,0,0,0.05); border-color: rgba(0,0,0,0.28); }
    .hn-footer-submit:hover .hn-btn-arrow { opacity: 1; transform: translateX(0); }
    .hn-footer-submit:hover span { transform: translateX(8px); }

    .hn-email-input {
      flex: 1;
      max-width: 280px;
      padding: 12px 16px;
      border: 1px solid #DDDDD8;
      border-radius: 8px;
      font-size: 15px;
      font-family: inherit;
      color: #111;
      background: #fff;
      outline: none;
      transition: border-color 200ms cubic-bezier(0.22,1,0.36,1), box-shadow 200ms cubic-bezier(0.22,1,0.36,1);
    }
    .hn-email-input:hover,
    .hn-email-input:focus {
      border-color: #888;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
    }

    .hn-contact-link {
      color: #111;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color 200ms cubic-bezier(0.22,1,0.36,1);
    }
    .hn-contact-link:hover { color: #F55D11; }

    /* --- Liquid glass card --- */
    .liquid-glass {
      position: relative;
      background: rgba(255, 255, 255, 0.38);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.7);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.08),
        inset 0 1.5px 0 rgba(255, 255, 255, 0.9),
        inset 0 -1px 0 rgba(255, 255, 255, 0.25),
        inset 1px 0 0 rgba(255, 255, 255, 0.5),
        inset -1px 0 0 rgba(255, 255, 255, 0.5);
      overflow: hidden;
    }
    .liquid-glass::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.28) 0%,
        rgba(255, 255, 255, 0.06) 50%,
        rgba(180, 160, 255, 0.06) 100%
      );
      pointer-events: none;
    }
  </style>
</head>
<body>

<Nav />

<!-- ===== HERO ===== -->
<section class="hero-no-bottom-pad" style="background: radial-gradient(circle, #C8C8CC 1.5px, transparent 1.5px) 0 0 / 24px 24px, linear-gradient(in oklab 180deg, oklab(100% 0 0) 14%, oklab(84.3% 0.005 -0.016) 120%); padding: 128px 24px 0; margin-top: 65px;">
  <div class="hn-container">
    <h1 style="font-size: clamp(40px, 5.5vw, 80px); font-weight: 500; line-height: 1.0; letter-spacing: -0.025em; color: #111; text-align: center; margin: 0 auto 40px;">
      Stop spending money on the<br class="desktop-br"> wrong custom software and AI
    </h1>
    <div class="hero-grid">
      <!-- Left: editorial body copy -->
      <div style="display: flex; flex-direction: column; gap: 20px; padding-top: 8px;">
        <p class="hero-body-text" style="margin: 0; font-size: 22px; line-height: 1.5em; letter-spacing: -0.01em; color: #1A1A1A;">There are plenty of software teams you could hire.</p>
        <p class="hero-body-text" style="margin: 0; font-size: 22px; line-height: 1.5em; letter-spacing: -0.01em; color: #1A1A1A;">But most dev firms build exactly what you ask for, skip the hard questions, and leave you with something that doesn't move the numbers.</p>
        <p class="hero-body-text" style="margin: 0; font-size: 22px; line-height: 1.5em; letter-spacing: -0.01em; color: #1A1A1A;">At Jams we figure out what your business actually needs first. Then we build it.</p>
      </div>
      <!-- Right: CTA card -->
      <div class="liquid-glass hero-liquid-card" style="padding: 32px 40px 44px; display: flex; flex-direction: column; gap: 16px;">
        <p class="hero-body-text" style="margin: 0; font-size: 22px; line-height: 1.5em; letter-spacing: -0.01em; color: #1A1A1A;">If you're sitting on ideas and don't know where to start:</p>
        <p class="hero-body-text" style="margin: 0; font-size: 22px; line-height: 1.5em; letter-spacing: -0.01em; color: #1A1A1A;">Book a call. Show up with your ideas and pains. Leave with a clear roadmap instead of a quote.</p>
        <a href="/start" class="sticky-btn">
          <i data-lucide="arrow-right" class="sticky-btn-arrow"></i>
          <span>Book your free shaping session</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ===== CUSTOMER BADGES ===== -->
<section style="background: #fff; padding: 32px 24px;">
  <div class="hn-container credentials-bar">
    <!-- Left: platform badges -->
    <div style="display: flex; align-items: center; gap: 16px; flex-shrink: 0;">
      <a href="https://bubble.io/expert/jamsagency" target="_blank" rel="noopener noreferrer" style="text-decoration: none; flex-shrink: 0; display: block; opacity: 1; transition: opacity 200ms cubic-bezier(0.22, 1, 0.36, 1);" onmouseenter="this.style.opacity='0.7'" onmouseleave="this.style.opacity='1'">
        <img src="/bubble-badge.svg" alt=".bubble Silver Agency Partner" height="72" style="height: 72px; width: auto; display: block;" />
      </a>
      <a href="https://clutch.co/profile/jams-agency" target="_blank" rel="noopener noreferrer" style="text-decoration: none; flex-shrink: 0; display: block; opacity: 1; transition: opacity 200ms cubic-bezier(0.22, 1, 0.36, 1);" onmouseenter="this.style.opacity='0.7'" onmouseleave="this.style.opacity='1'">
        <img src="/clutch-badge.svg" alt="Clutch 5.0" height="72" style="height: 72px; width: auto; display: block;" />
      </a>
    </div>
    <!-- Right: label + client logos grouped together -->
    <div class="trusted-by-group">
      <span class="trusted-by-label" style="font-size: 15px; font-weight: 400; color: #6B6B75; width: 224px; line-height: 1.3; letter-spacing: -0.01em;">
        Trusted by +30 founders and operators from teams like
      </span>
      <div class="client-logos">
        <img src="/logo-dropcar.png" alt="DropCar" height="32" style="height: 32px; width: auto; object-fit: contain;" />
        <img src="/redhorse-logo-2x.png" alt="Red Horse Mountain Ranch" height="65" style="height: 65px; width: auto; object-fit: contain;" />
        <img src="/logo-93percent.png" alt="93 Percent Club" height="32" style="height: 32px; width: auto; object-fit: contain;" />
      </div>
    </div>
  </div>
</section>

<!-- ===== FEELS ===== -->
<section style="background: #F3F3F3; padding: 128px 24px;">
  <div class="hn-container">
    <h2 style="font-size: clamp(36px, 4.2vw, 60px); font-weight: 500; letter-spacing: -0.02em; text-align: center; margin: 0 0 48px; color: #111;">
      It probably feels like this...
    </h2>
    <div class="sticky-board">
      <div class="sticky" style="left: 2%; top: 7%; transform: rotate(-3.5deg);">We have twenty ideas. Which one do we start with?</div>
      <div class="sticky" style="left: 25%; top: 3%; transform: rotate(2.5deg);">What if we look up in Upwork?</div>
      <div class="sticky" style="left: 53%; top: 9%; transform: rotate(-1.5deg); max-width: 220px;">US software firms are so expensive, but could we trust a team from abroad?</div>
      <div class="sticky" style="right: 1%; top: 4%; transform: rotate(5deg);">9 months for custom software??!</div>
      <div class="sticky" style="left: 9%; top: 44%; transform: rotate(-6deg);">What should we actually build?</div>
      <div class="sticky" style="left: 40%; top: 37%; transform: rotate(3.5deg);">Dev firms don't really get us</div>
      <div class="sticky" style="right: 3%; top: 41%; transform: rotate(-2.5deg); max-width: 200px;">Where does AI actually move the needle for our business?</div>
      <div class="sticky" style="left: 2%; top: 65%; transform: rotate(3deg); max-width: 210px;">Who do we trust to deliver and not disappear halfway through?</div>
      <div class="sticky" style="left: 29%; top: 71%; transform: rotate(-5deg);">Dev firms just come back with quotes</div>
      <div class="sticky" style="left: 55%; top: 62%; transform: rotate(2deg);">Should we just hire our own dev?</div>
      <div class="sticky" style="right: 2%; top: 68%; transform: rotate(-3.5deg);">How much is this going to cost?</div>
    </div>
  </div>
</section>

<!-- ===== CASES ===== -->
<section style="background: #fff; padding: 128px 24px;">
  <div class="hn-container">
    <div class="cases-header">
