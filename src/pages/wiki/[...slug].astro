---
import { getCollection, getEntry } from 'astro:content';
import WikiLayout from '../../layouts/WikiLayout.astro';

export const prerender = false;

const { slug } = Astro.params;
const slugPath = slug ?? 'index';

let entry;

try {
  entry = await getEntry('wiki', slugPath);
  if (!entry) {
    entry = await getEntry('wiki', `${slugPath}/index`);
  }
} catch {
  entry = null;
}

if (!entry) {
  return Astro.redirect('/wiki');
}

const { Content } = await entry.render();

const isHub = entry.id.endsWith('/index');

let hubCards: { title: string; href: string; description: string }[] = [];

if (isHub) {
  const section = entry.data.section;
  const allEntries = await getCollection('wiki');
  const descriptions: Record<string, string> = {
    'qa/testing': 'Branch structure, testing flow, roles, and checklists.',
    'qa/workshop': 'Role-by-role checklists and key insights from our QA workshop.',
  };
  hubCards = allEntries
    .filter((e) => e.id.startsWith(`${section}/`) && !e.id.endsWith('/index'))
    .map((e) => ({
      title: e.data.title,
      href: `/wiki/${e.id}`,
      description: descriptions[e.id] ?? '',
    }));
}
---

<WikiLayout title={entry.data.title}>
  <h1>{entry.data.title}</h1>
  <Content />

  {isHub && hubCards.length > 0 && (
    <div class="wiki-hub-cards">
      {hubCards.map((card) => (
        <a href={card.href} class="wiki-card">
          <div class="wiki-card-icon">
            <i class="ph ph-file-text"></i>
          </div>
          <div class="wiki-card-body">
            <h3>{card.title}</h3>
            {card.description && <p>{card.description}</p>}
          </div>
          <i class="ph ph-arrow-right wiki-card-arrow"></i>
        </a>
      ))}
    </div>
  )}
</WikiLayout>

<style>
  .wiki-hub-cards {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 8px;
  }

  .wiki-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    background: var(--bg);
    border-radius: var(--radius-lg);
    border: 0.5px solid var(--border-soft);
    box-shadow: var(--shadow-card), var(--shadow-inset-top);
    text-decoration: none;
    transition: box-shadow var(--dur-base) var(--ease-out);
  }

  .wiki-card:hover {
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.10), 0 4px 6px -4px rgba(0,0,0,0.10), var(--shadow-inset-top);
  }

  .wiki-card:hover .wiki-card-arrow {
    color: var(--orange);
    transform: translateX(2px);
  }

  .wiki-card-icon {
    width: 38px;
    height: 38px;
    background: var(--bg-muted);
    border-radius: 10px;
    border: 0.5px solid var(--border-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 18px;
    color: var(--fg-subtle);
  }

  .wiki-card-body {
    flex: 1;
    min-width: 0;
  }

  .wiki-card-body h3 {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--fg);
    letter-spacing: -0.01em;
    margin-top: 0;
    margin-bottom: 2px;
  }

  .wiki-card-body p {
    font-family: var(--font-sans);
    font-size: 13.5px;
    color: var(--fg-subtle);
    line-height: 1.5;
    margin: 0;
  }

  .wiki-card-arrow {
    font-size: 16px;
    color: var(--fg-faint);
    flex-shrink: 0;
    transition: color var(--dur-base) var(--ease-out),
                transform var(--dur-base) var(--ease-out);
  }
</style>
