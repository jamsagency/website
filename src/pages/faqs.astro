---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';

const faqs = [
  { q: 'What do you actually build?', a: 'Custom web and mobile applications. Not websites, not templates, not off-the-shelf tools with your logo on them. We build products around the specific workflow your business depends on: booking platforms, ops tools, marketplaces, AI agents, membership platforms.' },
  { q: 'How is this different from hiring a dev shop?', a: 'Most dev shops build exactly what you ask for. We figure out what you actually need first. Before we write a line of code, we map your operation, identify where the real problem is, and define what we\'re building and why. The Blueprint phase exists because the most expensive mistake in software is building the wrong thing well.' },
  { q: 'What if I don\'t know exactly what I want to build yet?', a: 'That\'s exactly what the free shaping session is for. Show up with your ideas and your pain points. We map the problem, challenge your assumptions, and figure out what actually needs to exist. You leave with a direction, not a quote.' },
  { q: 'Why would I trust a team based in LATAM?', a: 'Fair question. We work exclusively with US and Canada-based clients, which means we\'re timezone-friendly and used to operating at that standard. Our team is senior. And you can talk to our clients.' },
  { q: 'How does the process work?', a: 'Three phases. A free 60-minute shaping session where we map your problem. Then the Blueprint: two weeks, starting at $3,500, where we define flows, map AI opportunities, build a prototype, and give you a fixed price for the build. Then the build itself, delivered on time, on budget, with quarterly reviews and performance-linked pricing where it makes sense.' },
  { q: 'What does it cost?', a: 'The shaping session is free. Blueprint starts at $3,500. Development starts at $5,000 per month. We don\'t bill by the hour. Every engagement has a monthly floor and ceiling based on output. Where we own a metric like bookings or conversions, we tie part of our fee to that metric.' },
  { q: 'How fast do you ship?', a: 'Blueprint: two weeks. First version of the product: 4 to 8 weeks depending on complexity.' },
  { q: 'Do I own everything at the end?', a: 'Yes. The application, the Figma files, all design assets, all documentation transfer to you at the end of the engagement. No lock-in.' },
  { q: 'What is Bubble and does it matter?', a: 'Bubble is our primary build tool for most products. It lets us ship faster and at a lower cost without compromising results. For products with very high transaction volume or complex native requirements, we build in code. We recommend the right tool for your product, not the one we\'re most comfortable with.' },
  { q: 'Do you work with AI?', a: 'Yes, from the start. We map AI opportunities during the shaping session, build AI into the product where it actually moves the numbers, and avoid bolting it on as a feature after the fact.' },
  { q: 'What if I already have a product that needs a team?', a: 'We work with existing products too. If you need ongoing delivery, a product partner, or a team that can take over from a previous agency, book the shaping session and let\'s figure out what that looks like.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title="FAQs to build custom AI and software"
  description="How much does custom software cost? How long does it take? The questions founders ask before hiring a dev team."
  schema={faqSchema}
>
  <!-- Hero -->
  <section class="hero-bg" style="padding: 128px 24px; margin-top: 65px;">
    <div class="hn-container">
      <h1 style="font-size: clamp(40px, 5.5vw, 80px); font-weight: 500; line-height: 1.0; letter-spacing: -0.025em; color: #111; text-align: center; margin: 0 auto;">Things you are probably wondering</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="max-w-2xl mx-auto">
        <dl class="flex flex-col">
          {faqs.map(({ q, a }) => (
            <div class="faq-item" style="border-bottom: 1px solid rgba(0,0,0,0.08);">
              <dt>
                <button class="faq-trigger" aria-expanded="false" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; text-align: left; padding: 24px 0; background: none; border: none; cursor: pointer;">
                  <span style="font-size: 20px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.3; color: #0F1112;">{q}</span>
                  <span class="faq-icon" style="flex-shrink: 0; font-size: 24px; line-height: 1; color: #A85DFF; transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);" aria-hidden="true">+</span>
                </button>
              </dt>
              <dd class="faq-body" style="overflow: hidden; max-height: 0; margin: 0; transition: max-height 400ms cubic-bezier(0.22, 1, 0.36, 1);">
                <p style="font-size: 18px; line-height: 1.7; letter-spacing: -0.01em; color: #555; padding-bottom: 24px;">{a}</p>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
  <CTASection />

<script>
  const items = document.querySelectorAll('.faq-item');

  items.forEach(item => {
    const trigger = item.querySelector('.faq-trigger') as HTMLButtonElement;
    const body = item.querySelector('.faq-body') as HTMLElement;
    const icon = item.querySelector('.faq-icon') as HTMLElement;

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      // Close all
      items.forEach(i => {
        (i.querySelector('.faq-trigger') as HTMLButtonElement).setAttribute('aria-expanded', 'false');
        (i.querySelector('.faq-icon') as HTMLElement).style.transform = 'rotate(0deg)';
        (i.querySelector('.faq-body') as HTMLElement).style.maxHeight = '0';
      });

      if (!isOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        icon.style.transform = 'rotate(45deg)';
        body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });
</script>
</BaseLayout>
