---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Book a free shaping session with Jams"
  description="We map your operation, find where software and AI move the needle, and give you a clear next step instead of a quote."
>

<div id="start-wrapper" style="margin-top: 65px; --hero-h: 700px;">
  <div class="start-outer">
    <div class="hn-container">
      <div class="start-layout">

        <!-- ===== HERO PORTION (grid item 1) ===== -->
        <div id="hero-portion" class="start-hero-portion">
          <h1 style="font-size: clamp(36px, 4.5vw, 64px); font-weight: 500; line-height: 1.05; letter-spacing: -0.025em; color: #111; margin: 0 0 40px;">
            Before you hire anyone to build anything, do this.
          </h1>
          <div style="display: flex; flex-direction: column; gap: 20px;">
            <p style="margin: 0; font-size: 20px; line-height: 1.65; letter-spacing: -0.01em; color: #1A1A1A;">The biggest mistake in custom software isn't bad code. It's building the wrong thing.</p>
            <p style="margin: 0; font-size: 20px; line-height: 1.65; letter-spacing: -0.01em; color: #1A1A1A;">Most businesses hire a dev team before they know exactly what to build. They write a brief, the team builds what's in the brief, and months later the product doesn't move anything because the brief missed the real problem.</p>
            <p style="margin: 0; font-size: 20px; line-height: 1.65; letter-spacing: -0.01em; color: #1A1A1A;">The free shaping session exists to fix that before it costs you money.</p>
          </div>
        </div>

        <!-- ===== FORM (grid item 2 — col 2 desktop, row 2 mobile) ===== -->
        <div class="start-form-col">

          <!-- Form card -->
          <div id="form-card" class="liquid-glass">

            <!-- Progress -->
            <div style="padding: 24px 28px 0;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-size: 16px; font-weight: 500; letter-spacing: -0.01em; color: #262626;">Book your free shaping session</span>
                <span id="step-label" style="font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #A3A3A3;">Step 1 of 4</span>
              </div>
              <div style="height: 2px; width: 100%; border-radius: 999px; background: #F3F3F5;">
                <div id="progress-fill" style="height: 2px; width: 25%; border-radius: 999px; background: #A85DFF; transition: width 300ms cubic-bezier(0.22,1,0.36,1);"></div>
              </div>
            </div>

            <!-- Form -->
            <form id="apply-form" novalidate>

              <!-- Step 1 -->
              <div class="apply-step" data-step="1">
                <div style="padding: 24px 28px; display: flex; flex-direction: column; gap: 20px;">
                  <div class="start-name-grid" style="gap: 12px;">
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                      <label class="field-label" for="f-name">Your name</label>
                      <input id="f-name" name="name" type="text" required class="form-input" placeholder="Juan Germano" autocomplete="name" />
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                      <label class="field-label" for="f-email">Email</label>
                      <input id="f-email" name="email" type="email" required class="form-input" placeholder="you@company.com" autocomplete="email" />
                    </div>
                  </div>
                  <div style="display: flex; flex-direction: column; gap: 6px;">
                    <label class="field-label" for="f-problem">What problem are you trying to solve?</label>
                    <textarea id="f-problem" name="problem" required rows="4" class="form-textarea" placeholder="Describe the problem in plain terms..."></textarea>
                  </div>
                </div>
              </div>

              <!-- Step 2 -->
              <div class="apply-step" data-step="2" style="display:none;">
                <div style="padding: 24px 28px; display: flex; flex-direction: column; gap: 20px;">
                  <div style="display: flex; flex-direction: column; gap: 6px;">
                    <label class="field-label" for="f-users">Who will use this product?</label>
                    <textarea id="f-users" name="users" required rows="3" class="form-textarea" placeholder="e.g. Ranch guests and an admin managing reservations..."></textarea>
                  </div>
                  <div style="display: flex; flex-direction: column; gap: 8px;">
                    <span class="field-label">Have you built anything for this yet?</span>
                    <label class="radio-card"><input type="radio" name="existing" value="no" /><span>No, starting from scratch</span></label>
                    <label class="radio-card"><input type="radio" name="existing" value="yes-app" /><span>Yes, we have an existing app or tool</span></label>
                  </div>
                  <div style="display: flex; flex-direction: column; gap: 6px;">
                    <label class="field-label" for="f-success">What does success look like in 6 months?</label>
                    <textarea id="f-success" name="success" required rows="3" class="form-textarea" placeholder="In 6 months we will have..."></textarea>
                  </div>
                </div>
              </div>

              <!-- Step 3 -->
              <div class="apply-step" data-step="3" style="display:none;">
                <div style="padding: 24px 28px; display: flex; flex-direction: column; gap: 20px;">
                  <div style="display: flex; flex-direction: column; gap: 8px;">
                    <span class="field-label">What is your timeline?</span>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                      <label class="radio-card"><input type="radio" name="timeline" value="asap" /><span>As soon as possible</span></label>
                      <label class="radio-card"><input type="radio" name="timeline" value="3months" /><span>Within 3 months</span></label>
                      <label class="radio-card"><input type="radio" name="timeline" value="6months" /><span>Within 6 months</span></label>
                      <label class="radio-card"><input type="radio" name="timeline" value="no-deadline" /><span>No hard deadline yet</span></label>
                    </div>
                  </div>
                  <div style="display: flex; flex-direction: column; gap: 8px;">
                    <span class="field-label">Annual revenue?</span>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                      <label class="radio-card"><input type="radio" name="revenue" value="pre-revenue" /><span>Pre-revenue</span></label>
                      <label class="radio-card"><input type="radio" name="revenue" value="under-500k" /><span>Under $500k</span></label>
                      <label class="radio-card"><input type="radio" name="revenue" value="500k-2m" /><span>$500k – $2M</span></label>
                      <label class="radio-card"><input type="radio" name="revenue" value="2m-10m" /><span>$2M – $10M</span></label>
                      <label class="radio-card"><input type="radio" name="revenue" value="over-10m" /><span>Over $10M</span></label>
                      <label class="radio-card"><input type="radio" name="revenue" value="prefer-not" /><span>Prefer not to say</span></label>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Step 4 -->
              <div class="apply-step" data-step="4" style="display:none;">
                <div style="padding: 24px 28px; display: flex; flex-direction: column; gap: 20px;">
                  <div style="display: flex; flex-direction: column; gap: 8px;">
                    <span class="field-label">Budget for the build?</span>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                      <label class="radio-card"><input type="radio" name="budget" value="under-10k" /><span>Under $10k</span></label>
                      <label class="radio-card"><input type="radio" name="budget" value="10k-20k" /><span>$10k to $20k</span></label>
                      <label class="radio-card"><input type="radio" name="budget" value="20k-50k" /><span>$20k to $50k</span></label>
                      <label class="radio-card"><input type="radio" name="budget" value="over-50k" /><span>Over $50k</span></label>
                      <label class="radio-card"><input type="radio" name="budget" value="not-sure" /><span>Not sure yet</span></label>
                    </div>
                  </div>
                  <div style="display: flex; flex-direction: column; gap: 8px;">
                    <span class="field-label">How did you find us?</span>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                      <label class="radio-card"><input type="radio" name="source" value="referral" /><span>Referral</span></label>
                      <label class="radio-card"><input type="radio" name="source" value="linkedin" /><span>LinkedIn</span></label>
                      <label class="radio-card"><input type="radio" name="source" value="search" /><span>Search</span></label>
                      <label class="radio-card"><input type="radio" name="source" value="content" /><span>Content</span></label>
                      <label class="radio-card"><input type="radio" name="source" value="ai" /><span>AI</span></label>
                      <label class="radio-card"><input type="radio" name="source" value="other" /><span>Other</span></label>
                    </div>
                  </div>
                  <div id="referral-detail" style="display:none; flex-direction: column; gap: 6px;">
                    <input id="f-referral" name="referral" type="text" class="form-input" placeholder="Name of the person who referred you" />
                  </div>
                </div>
              </div>

              <!-- Navigation -->
              <div style="display: flex; align-items: center; padding: 16px 28px; border-top: 1px solid rgba(0,0,0,0.06);">
                <button type="button" id="back-btn" style="display:none; align-items: center; gap: 6px; font-size: 14px; font-weight: 500; letter-spacing: -0.01em; color: #A3A3A3; background: none; border: none; cursor: pointer; padding: 0; font-family: inherit; transition: color 0.12s;"><i data-lucide="arrow-left" style="width: 14px; height: 14px; stroke: currentColor; flex-shrink: 0;"></i> Back</button>
                <div style="margin-left: auto;">
                  <button type="button" id="next-btn" class="jams-footer-submit">
                    <i data-lucide="arrow-right" class="btn-arrow" style="stroke:#111;"></i>
                    <span>Continue</span>
                  </button>
                  <button type="submit" id="submit-btn" class="jams-footer-submit" style="display:none;">
                    <i data-lucide="arrow-right" class="btn-arrow" style="stroke:#111;"></i>
                    <span>Submit</span>
                  </button>
                </div>
              </div>

            </form>
          </div>

          <!-- Success state -->
          <div id="success-card" style="display:none; border: 1px solid rgba(0,0,0,0.08); border-radius: 16px; background: #fff; box-shadow: 0 4px 24px rgba(0,0,0,0.07); padding: 48px 28px; flex-direction: column; align-items: center; gap: 20px; text-align: center;">
            <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(168,93,255,0.08); display: flex; align-items: center; justify-content: center; margin: 0 auto;">
              <i class="ph ph-check-circle" style="font-size: 26px; color: #A85DFF;"></i>
            </div>
            <div style="display: flex; flex-direction: column; gap: 10px;">
              <h3 style="font-size: 28px; font-weight: 500; letter-spacing: -0.02em; color: #111; margin: 0;">We got it.</h3>
              <p style="font-size: 16px; line-height: 1.65; letter-spacing: -0.01em; color: #555; margin: 0;">Someone from Jams will review your submission and reach out within 24 hours.</p>
            </div>
            <a href="https://cal.com/jjams/discovery" target="_blank" rel="noopener noreferrer" class="btn-primary" style="font-size: 15px; padding: 12px 28px; border-radius: 10px; margin-top: 8px; display: inline-block;">Book a call now</a>
          </div>

        </div>

        <!-- ===== REST OF CONTENT (grid item 3 — col 1 row 2 on desktop, row 3 on mobile) ===== -->
        <div class="start-content-rest">

          <!-- What happens in the session -->
          <div class="start-section" style="padding: 64px 0; border-bottom: 1px solid rgba(0,0,0,0.08);">
            <p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #999; margin: 0 0 20px;">What happens in the session</p>
            <div style="display: flex; flex-direction: column; gap: 20px;">
              <p style="margin: 0; font-size: 20px; line-height: 1.65; letter-spacing: -0.01em; color: #1A1A1A;">One hour. We map your operation, identify the exact problem worth solving, challenge your assumptions, and figure out what needs to be built and in what order.</p>
              <p style="margin: 0; font-size: 20px; line-height: 1.65; letter-spacing: -0.01em; color: #1A1A1A;">You bring your ideas and your pain points. We ask the hard questions. By the end you have a clear direction: not a quote, not a pitch deck, not a sales call dressed up as strategy.</p>
            </div>
          </div>

          <!-- What you walk away with -->
          <div class="start-section" style="padding: 64px 0; border-bottom: 1px solid rgba(0,0,0,0.08);">
            <p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #999; margin: 0 0 20px;">What you walk away with</p>
            <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px;">
              {[
                'A clear definition of the real problem.',
                'A recommendation for where AI and software actually make a difference for your specific operation.',
                'A sense of what a realistic product scope looks like.',
                'A next step: whether that\'s the Blueprint, a different path, or an honest "not yet."',
              ].map(item => (
                <li style="display: flex; align-items: baseline; gap: 12px; font-size: 20px; line-height: 1.55; letter-spacing: -0.01em; color: #1A1A1A;">
                  <span style="color: #F55D11; font-size: 20px; line-height: 0.9; flex-shrink: 0;">•</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Who this is for / not for -->
          <div class="start-section start-who-grid" style="border-bottom: 1px solid rgba(0,0,0,0.08);">
            <div>
              <p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #999; margin: 0 0 16px;">Who this is for</p>
              <p style="margin: 0; font-size: 17px; line-height: 1.65; letter-spacing: -0.01em; color: #404040;">Founders and operators with a real business: established revenue, a real team, and a process that's breaking under growth. People who have software or AI on their mind but don't know where to start, or who have been burned by a dev shop that built the wrong thing.</p>
            </div>
            <div>
              <p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #999; margin: 0 0 16px;">Who this is not for</p>
              <p style="margin: 0; font-size: 17px; line-height: 1.65; letter-spacing: -0.01em; color: #404040;">Founders with no revenue and no validation yet. Businesses that just need a developer to hand a spec to. Anyone who already knows exactly what they want built and just needs a quote.</p>
            </div>
          </div>

          <!-- It's actually free -->
          <div class="start-section" style="padding: 64px 0; border-bottom: 1px solid rgba(0,0,0,0.08);">
            <p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #999; margin: 0 0 20px;">It's actually free</p>
            <div style="display: flex; flex-direction: column; gap: 20px;">
              <p style="margin: 0; font-size: 20px; line-height: 1.65; letter-spacing: -0.01em; color: #1A1A1A;">No credit card. No obligation. No pitch at the end.</p>
              <p style="margin: 0; font-size: 20px; line-height: 1.65; letter-spacing: -0.01em; color: #1A1A1A;">We offer this because figuring out the right thing to build together is the only way to know if we're the right team to build it. The hour pays for itself regardless of what comes next.</p>
            </div>
          </div>

          <!-- What happens after -->
          <div class="start-section start-last-section" style="padding: 64px 0 0;">
            <p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #999; margin: 0 0 20px;">What happens after</p>
            <div style="display: flex; flex-direction: column; gap: 20px;">
              <p style="margin: 0; font-size: 20px; line-height: 1.65; letter-spacing: -0.01em; color: #1A1A1A;">If there's a fit, the next step is the Blueprint: two weeks, starting at $3,500. Every flow defined, a design prototype, and a fixed price for the full build. Everything decided before a line of code is written.</p>
              <p style="margin: 0; font-size: 20px; line-height: 1.65; letter-spacing: -0.01em; color: #1A1A1A;">If the session makes clear the timing isn't right, we'll tell you that too.</p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

</BaseLayout>

<style>
  /* ===== Desktop layout (≥991px) ===== */
  .start-outer {
    padding: 0 24px 128px;
  }
  .start-layout {
    display: grid;
    grid-template-columns: 1fr 460px;
    grid-template-rows: auto 1fr;
    column-gap: 80px;
    row-gap: 0;
    align-items: start;
  }
  /* Hero: col 1, row 1 */
  .start-hero-portion {
    grid-column: 1;
    grid-row: 1;
    padding: 128px 0 80px;
  }
  /* Form: col 2, spans both rows — sticky */
  .start-form-col {
    grid-column: 2;
    grid-row: 1 / 3;
    position: sticky;
    top: 0;
    align-self: start;
    padding-top: 128px;
  }
  /* Rest of content: col 1, row 2 */
  .start-content-rest {
    grid-column: 1;
    grid-row: 2;
  }
  .start-section {
    padding: 64px 0;
  }
  .start-last-section {
    padding: 64px 0 0;
  }
  .start-who-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 64px 0;
  }
  .start-name-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  /* ≤990px: single column — hero → form → rest */
  @media (max-width: 990px) {
    .start-layout {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .start-hero-portion {
      grid-column: 1;
      grid-row: 1;
      padding-top: 64px;
      padding-bottom: 48px;
    }
    .start-form-col {
      grid-column: 1;
      grid-row: 2;
      position: static;
      padding-top: 40px;
    }
    .start-content-rest {
      grid-column: 1;
      grid-row: 3;
    }
    .start-outer {
      padding-bottom: 80px;
    }
  }

  /* ≤768px: tighten vertical padding, collapse who-grid */
  @media (max-width: 768px) {
    .start-hero-portion {
      padding-top: 48px;
      padding-bottom: 36px;
    }
    .start-section {
      padding: 48px 0;
    }
    .start-last-section {
      padding: 48px 0 0;
    }
    .start-who-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 48px 0;
    }
    .start-outer {
      padding-bottom: 64px;
    }
  }

  /* ≤480px: stack name/email, stack radio grids, tighten further */
  @media (max-width: 480px) {
    .start-name-grid {
      grid-template-columns: 1fr;
    }
    .start-hero-portion {
      padding-top: 36px;
      padding-bottom: 28px;
    }
    .start-section {
      padding: 36px 0;
    }
    .start-last-section {
      padding: 36px 0 0;
    }
    .start-who-grid {
      padding: 36px 0;
    }
    .start-outer {
      padding-bottom: 48px;
    }
  }

  #start-wrapper {
    background:
      linear-gradient(to bottom, transparent var(--hero-h), #fff var(--hero-h)),
      radial-gradient(circle, #C8C8CC 1.5px, transparent 1.5px) 0 0 / 24px 24px,
      linear-gradient(in oklab 180deg, oklab(100% 0 0) 14%, oklab(84.3% 0.005 -0.016) 120%);
  }

  .field-label {
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #262626;
    line-height: 1.4;
  }
  .field-hint {
    font-family: inherit;
    font-size: 13px;
    letter-spacing: -0.01em;
    color: #A3A3A3;
    line-height: 1.55;
    margin: 0;
  }
  .form-input,
  .form-textarea {
    width: 100%;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 10px;
    padding: 10px 14px;
    font-family: inherit;
    font-size: 15px;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: #171717;
    background: #fff;
    outline: none;
    box-sizing: border-box;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .form-input:focus,
  .form-textarea:focus {
    border-color: #A85DFF;
    box-shadow: 0 0 0 3px rgba(168,93,255,0.1);
  }
  .form-input.error,
  .form-textarea.error { border-color: #F87171; }
  .form-textarea { resize: vertical; min-height: 88px; }
  .radio-card {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 10px;
    padding: 10px 14px;
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    letter-spacing: -0.01em;
    color: #525252;
    line-height: 1.4;
    transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
    user-select: none;
  }
  .radio-card input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }
  .radio-card:hover { border-color: #C4B5FD; }
  .radio-card:has(input:checked) {
    border-color: #A85DFF;
    background-color: rgba(168,93,255,0.05);
    color: #171717;
    font-weight: 500;
  }
  .apply-step { animation: stepIn 200ms ease; }
  @keyframes stepIn {
    from { opacity: 0; transform: translateY(5px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  /* Radio grids stack at 480px */
  @media (max-width: 480px) {
    .apply-step div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }

  ::placeholder { color: #A3A3A3; }
  #apply-form .jams-footer-submit .btn-arrow {
    top: 50%;
    transform: translateY(-50%) translateX(-6px);
  }
  #apply-form .jams-footer-submit:hover .btn-arrow {
    transform: translateY(-50%) translateX(0);
  }
</style>

<script>
  // Measure hero portion height and set background cut-off point
  function syncHeroHeight() {
    const wrapper = document.getElementById('start-wrapper');
    const heroPortion = document.getElementById('hero-portion');
    if (!wrapper || !heroPortion) return;
    const h = heroPortion.getBoundingClientRect().bottom - wrapper.getBoundingClientRect().top;
    wrapper.style.setProperty('--hero-h', Math.round(h) + 'px');
  }
  syncHeroHeight();
  window.addEventListener('resize', syncHeroHeight);

  // Form logic
  const TOTAL = 4;
  let current = 1;

  const formCard     = document.getElementById('form-card');
  const successCard  = document.getElementById('success-card');
  const stepLabel    = document.getElementById('step-label');
  const progressFill = document.getElementById('progress-fill') as HTMLElement;
  const backBtn      = document.getElementById('back-btn') as HTMLButtonElement;
  const nextBtn      = document.getElementById('next-btn') as HTMLButtonElement;
  const submitBtn    = document.getElementById('submit-btn') as HTMLButtonElement;
  const form         = document.getElementById('apply-form') as HTMLFormElement;

  function getStep(n: number) {
    return document.querySelector<HTMLElement>('.apply-step[data-step="' + n + '"]');
  }

  function goto(n: number) {
    document.querySelectorAll<HTMLElement>('.apply-step').forEach(el => el.style.display = 'none');
    const step = getStep(n);
    if (step) step.style.display = 'block';
    current = n;

    stepLabel!.textContent    = 'Step ' + n + ' of ' + TOTAL;
    progressFill.style.width  = ((n / TOTAL) * 100) + '%';
    backBtn.style.display     = n > 1 ? 'inline-flex' : 'none';
    nextBtn.style.display     = n === TOTAL ? 'none' : 'block';
    submitBtn.style.display   = n === TOTAL ? 'block' : 'none';
  }

  function validate(n: number) {
    const step = getStep(n);
    if (!step) return true;
    let ok = true;
    step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach(el => {
      if (!el.value.trim()) { el.classList.add('error'); ok = false; }
      else el.classList.remove('error');
    });
    return ok;
  }

  document.addEventListener('change', e => {
    const t = e.target as HTMLInputElement;
    if (t.type !== 'radio') return;
    if (t.name === 'source')
      (document.getElementById('referral-detail') as HTMLElement).style.display = t.value === 'referral' ? 'flex' : 'none';
  });

  document.addEventListener('input', e => (e.target as HTMLElement).classList.remove('error'));
  backBtn.addEventListener('click', () => goto(current - 1));
  nextBtn.addEventListener('click', () => { if (validate(current)) goto(current + 1); });

  form.addEventListener('submit', async e => {
    e.preventDefault();
    if (!validate(current)) return;
    submitBtn.textContent = 'Submitting...';
    submitBtn.disabled = true;
    try {
      const res  = await fetch('/api/apply', { method: 'POST', body: new FormData(form) });
      const json = await res.json();
      if (json.ok) {
        formCard!.style.display   = 'none';
        successCard!.style.display = 'flex';
      } else {
        submitBtn.textContent = 'Submit';
        submitBtn.disabled = false;
      }
    } catch {
      submitBtn.textContent = 'Submit';
      submitBtn.disabled = false;
    }
  });

  goto(1);
</script>
