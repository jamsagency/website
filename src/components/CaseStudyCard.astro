---
interface Props {
  title: string;
  slug: string;
  headline?: string;
  bullets?: string[];
  image?: string;
  imageAlt?: string;
  comingSoon?: boolean;
}

const { title, slug, headline = '', bullets = [], image, imageAlt, comingSoon = false } = Astro.props;
---

{comingSoon ? (
  <div class="cs-card cs-card--soon">
    <div class="cs-img-wrap">
      {image && (
        <img src={image} alt={imageAlt ?? title} width="600" height="360" loading="lazy" />
      )}
    </div>
    <div class="cs-body">
      <span class="cs-client">{title}</span>
      <span class="cs-soon-label">Coming soon</span>
    </div>
  </div>
) : (
  <div class="cs-card">
    <div class="cs-img-wrap">
      {image && (
        <img src={image} alt={imageAlt ?? title} width="600" height="360" loading="lazy" />
      )}
    </div>
    <div class="cs-body">
      <span class="cs-client">{title}</span>
      {headline && <h3 class="cs-headline">{headline}</h3>}
      {bullets.length > 0 && (
        <ul class="cs-bullets">
          {bullets.map((b) => (
            <li>
              <span aria-hidden="true">•</span>
              {b}
            </li>
          ))}
        </ul>
      )}
      <a href={`/work/${slug}`} class="read-link">
        <i data-lucide="arrow-right" class="read-link-arrow"></i>
        <span>Read case</span>
      </a>
    </div>
  </div>
)}

<style>
  .cs-card {
    background: #F6F6F6;
    border-radius: 16px;
    overflow: hidden;
  }
  .cs-card--soon .cs-img-wrap img {
    opacity: 0.35;
  }
  .cs-img-wrap img {
    width: 100%;
    height: 360px;
    object-fit: cover;
    display: block;
  }
  .cs-body {
    padding: 28px 28px 36px;
  }
  @media (max-width: 480px) {
    .cs-img-wrap img {
      height: 220px;
    }
    .cs-body {
      padding: 20px 20px 28px;
    }
    .cs-headline {
      font-size: 22px !important;
    }
  }
  .cs-client {
    display: block;
    font-size: 16px;
    font-weight: 400;
    color: #555;
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }
  .cs-headline {
    font-size: 28px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #111;
    margin: 0 0 18px;
  }
  .cs-bullets {
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cs-bullets li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 17px;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: #1A1A1A;
  }
  .cs-bullets li span {
    color: #F55D11;
    font-size: 20px;
    line-height: 0.9;
    flex-shrink: 0;
  }
  .cs-soon-label {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: #A3A3A3;
    letter-spacing: -0.01em;
  }
</style>
