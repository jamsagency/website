---
const links = [
  { label: 'Work',     href: '/work' },
  { label: 'About',   href: '/about' },
  { label: 'AI',      href: '/ai' },
  { label: 'Thoughts', href: '/blog' },
  { label: 'FAQs',    href: '/faqs' },
];

const pathname = Astro.url.pathname;
---

<header class="jams-nav">
  <div class="jams-nav-inner">
    <a href="/" class="jams-nav-logo" aria-label="Jams home">
      <img src="/jams-logo-black.svg" alt="Jams" width="142" height="51" style="width:142px; height:auto;" />
      <span class="jams-nav-tagline">is the product team with skin in the game</span>
    </a>
    <nav class="jams-nav-links" aria-label="Main navigation">
      {links.map(({ label, href }) => (
        <a href={href} class={pathname.startsWith(href) ? 'nav-active' : ''}>{label}</a>
      ))}
      <a href="/start" class="btn-primary jams-nav-cta" id="nav-cta-btn">
        <i data-lucide="arrow-right" class="btn-arrow"></i>
        <span>Book a call</span>
      </a>
    </nav>
    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-open"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="jams-hamburger"
    >
      <i class="ph ph-list" style="font-size:20px;"></i>
    </button>
  </div>
</header>

<!-- Mobile: full-screen overlay -->
<div
  id="mobile-menu"
  aria-hidden="true"
  class="jams-mobile-menu"
>
  <div class="jams-mobile-header">
    <a href="/" aria-label="Jams home" class="mobile-menu-link">
      <img src="/jams-logo-white.svg" alt="Jams" width="120" height="44" style="height:40px; width:auto;" />
    </a>
    <button id="mobile-menu-close" aria-label="Close menu" class="jams-mobile-close">
      <i class="ph ph-x" style="font-size:18px;"></i>
    </button>
  </div>
  <nav class="jams-mobile-links">
    {links.map(({ label, href }) => (
      <a href={href} class="mobile-menu-link jams-mobile-link">
        {label}
        <i class="ph ph-arrow-right" style="font-size:20px; color:rgba(255,255,255,0.3);"></i>
      </a>
    ))}
  </nav>
  <div class="jams-mobile-cta">
    <a href="/start" id="mobile-cta-btn" class="mobile-menu-link btn-primary" style="width:100%; justify-content:center; font-size:16px; border-radius:12px; padding:16px 24px;">
      <i data-lucide="arrow-right" class="btn-arrow"></i>
      <span>Book a call</span>
    </a>
  </div>
</div>

<style is:global>
  .jams-nav {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    padding: 8px 24px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }
  .jams-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 24px;
  }
  .jams-nav-logo {
    display: flex;
    align-items: center;
    gap: 0;
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }
  .jams-nav-tagline {
    font-size: 16px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #0F1112;
    line-height: 1.25;
    margin-left: -3px;
    position: relative;
    top: 0;
  }
  .jams-nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
  }
  .jams-nav-links a:not(.btn-primary) {
    font-size: 16px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #0F1112;
    text-decoration: none;
    position: relative;
    transition: color 0.12s;
  }
  .jams-nav-links a:not(.btn-primary)::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: #0F1112;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 200ms cubic-bezier(0.22, 1, 0.36, 1), transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .jams-nav-links a:not(.btn-primary):hover::after,
  .jams-nav-links a.nav-active::after {
    opacity: 1;
    transform: translateY(0);
  }
  .jams-nav-links a:not(.btn-primary):hover { color: #0F1112; }
  .jams-nav-cta {
    width: 130px;
    font-size: 16px !important;
    letter-spacing: -0.01em !important;
  }

  /* Hamburger — hidden on desktop */
  .jams-hamburger {
    display: none;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 0.5px solid var(--border-soft);
    background: #F3F3F5;
    box-shadow: var(--shadow-card), var(--shadow-inset-top);
    align-items: center;
    justify-content: center;
    color: #404040;
    cursor: pointer;
  }
  @media (max-width: 992px) {
    .jams-nav-links { display: none; }
    .jams-hamburger { display: flex; }
    .jams-nav-tagline { display: none; }
  }
  @media (max-width: 768px) {
    .jams-nav-inner { padding-left: 0; padding-right: 0; }
  }
  @media (max-width: 480px) {
    .jams-nav { padding-left: 16px; padding-right: 16px; }
  }

  /* Mobile overlay */
  .jams-mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    background: #0B0B0B;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 200ms cubic-bezier(0.22,1,0.36,1), transform 200ms cubic-bezier(0.22,1,0.36,1);
  }
  .jams-mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .jams-mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 24px;
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
  }
  .jams-mobile-close {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 0.5px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    cursor: pointer;
  }
  .jams-mobile-links {
    display: flex;
    flex-direction: column;
    padding: 40px 24px 0;
    gap: 4px;
    flex: 1;
  }
  .jams-mobile-link {
    font-family: var(--font-sans);
    color: #fff;
    padding: 16px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 500;
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
    text-decoration: none;
  }
  .jams-mobile-cta {
    padding: 32px 24px 48px;
  }
</style>

<script>
  const openBtn = document.getElementById('mobile-menu-open');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');

  function openMenu() {
    menu?.classList.add('is-open');
    menu?.setAttribute('aria-hidden', 'false');
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.remove('is-open');
    menu?.setAttribute('aria-hidden', 'true');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  document.querySelectorAll('.mobile-menu-link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  document.getElementById('nav-cta-btn')?.addEventListener('click', () => {
    window.posthog?.capture('nav_cta_clicked');
  });

  document.getElementById('mobile-cta-btn')?.addEventListener('click', () => {
    window.posthog?.capture('mobile_cta_clicked');
  });
</script>
