---
---

<footer class="jams-footer">

  <!-- Top: newsletter + contact -->
  <div class="jams-footer-top">
    <div class="hn-container jams-footer-top-grid">

      <!-- Newsletter -->
      <div>
        <h3 class="jams-footer-h3">Sign up to our monthly digest</h3>
        <p class="jams-footer-body" style="margin: 0 0 24px;">
          Every month we share insights and updates on AI, software development and product design.
        </p>
        <form id="newsletter-form" style="display: flex; gap: 10px;" novalidate>
          <input
            type="email"
            name="email"
            placeholder="mary@yerbamatemakers.com"
            required
            class="jams-email-input"
          />
          <button type="submit" class="jams-footer-submit">
            <i data-lucide="arrow-right" class="btn-arrow" style="stroke:#111;"></i>
            <span>Sign up</span>
          </button>
        </form>
        <p id="newsletter-success" style="display:none; font-size: 15px; letter-spacing: -0.01em; color: #111; margin: 0;">You're in. We'll be in touch.</p>
        <p id="newsletter-error" style="display:none; font-size: 15px; letter-spacing: -0.01em; color: #EF4444; margin: 0;">Something went wrong. Try again.</p>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="jams-footer-h3">Reach out or call us, seriously</h3>
        <p class="jams-footer-body" style="margin: 0;">
          Juan, Founder and CEO stepping in. You can email me at <a href="mailto:j@jams.agency" class="contact-link">j@jams.agency</a>,
          drop me a <a href="https://wa.me/+13079981554" target="_blank" rel="noopener noreferrer" class="contact-link">WhatsApp message</a>
          or call me at <a href="tel:+13079981554" class="contact-link">+1 (307) 998-1554</a>
        </p>
      </div>

    </div>
  </div>

  <!-- Bottom: logo + nav -->
  <div class="jams-footer-bottom">
    <div class="hn-container jams-footer-bottom-grid">

      <!-- Logo + tagline + socials -->
      <div>
        <a href="/" aria-label="Jams home" style="display: inline-block; margin-bottom: 14px;">
          <img src="/jams-glass-icon.png" alt="Jams" width="72" height="72" style="height: 72px; width: auto;" />
        </a>
        <p class="jams-footer-tagline">
          The AI and software team for founders who need the right thing built
        </p>
        <div style="display: flex; gap: 20px;">
          <a href="https://linkedin.com/company/jamsagency" target="_blank" rel="noopener noreferrer" class="jams-footer-link">LinkedIn</a>
          <a href="https://x.com/jamsagency" target="_blank" rel="noopener noreferrer" class="jams-footer-link">X</a>
          <a href="https://www.instagram.com/jamsagency_/" target="_blank" rel="noopener noreferrer" class="jams-footer-link">Instagram</a>
        </div>
      </div>

      <!-- Nav columns -->
      <div class="jams-footer-nav-grid">
        <nav style="display: flex; flex-direction: column; gap: 14px;" aria-label="Main pages">
          <a href="/" class="jams-footer-link">Home</a>
          <a href="/work" class="jams-footer-link">Work</a>
          <a href="/about" class="jams-footer-link">About</a>
          <a href="/ai" class="jams-footer-link">AI</a>
          <a href="/blog" class="jams-footer-link">Thoughts</a>
        </nav>
        <nav style="display: flex; flex-direction: column; gap: 14px;" aria-label="Additional links">
          <a href="/bubble" class="jams-footer-link">Bubble Silver Agency</a>
          <a href="/hospitality" class="jams-footer-link">Hospitality</a>
          <a href="/shaping" class="jams-footer-link">Shaping</a>
          <a href="/faqs" class="jams-footer-link">FAQs</a>
          <a href="/start" class="jams-footer-link">Book a call</a>
        </nav>
      </div>

    </div>
  </div>

</footer>

<style is:global>
  .jams-footer-top-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .jams-footer-bottom-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: start;
  }
  .jams-footer-nav-grid {
    display: grid;
    grid-template-columns: auto auto;
    gap: 56px;
  }
  @media (max-width: 768px) {
    .jams-footer-top-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .jams-footer-bottom-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .jams-footer-nav-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    /* Footer provides its own side padding via CSS classes — zero the inner container */
    .jams-footer-top .hn-container,
    .jams-footer-bottom .hn-container {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
  }
  @media (max-width: 480px) {
    .jams-footer-top  { padding-left: 16px !important; padding-right: 16px !important; }
    .jams-footer-bottom { padding-left: 16px !important; padding-right: 16px !important; }
  }
  @media (max-width: 480px) {
    /* Stack newsletter form on very small screens */
    #newsletter-form {
      flex-direction: column;
    }
    .jams-email-input {
      max-width: 100%;
    }
    .jams-footer-submit {
      align-self: flex-start;
    }
  }

  .jams-footer {
    background: #fff;
    border-top: 0.5px solid rgba(0,0,0,0.08);
  }
  .jams-footer-top {
    padding: 128px 24px 0;
    border-bottom: 1px solid #EBEBEB;
  }
  .jams-footer-top .hn-container {
    padding-bottom: 72px;
  }
  .jams-footer-bottom {
    padding: 48px 24px 64px;
  }
  .jams-footer-h3 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #111;
    margin: 0 0 12px;
    line-height: 1.2;
  }
  .jams-footer-body {
    font-size: 15px;
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: #555555;
  }
  .jams-footer-tagline {
    font-size: 15px;
    line-height: 1.6;
    letter-spacing: -0.01em;
    color: #444444;
    margin: 0 0 20px;
    max-width: 320px;
  }
  .jams-footer-link {
    font-size: 15px;
    font-weight: 400;
    color: #111;
    text-decoration: none;
    position: relative;
    width: fit-content;
    transition: color 0.12s;
  }
  .jams-footer-link::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: #111;
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 200ms cubic-bezier(0.22,1,0.36,1), transform 200ms cubic-bezier(0.22,1,0.36,1);
  }
  .jams-footer-link:hover::after { opacity: 1; transform: translateY(0); }

  .jams-email-input {
    flex: 1;
    max-width: 280px;
    padding: 12px 16px;
    border: 1px solid #DDDDD8;
    border-radius: 8px;
    font-size: 15px;
    font-family: inherit;
    color: #111;
    background: #fff;
    outline: none;
    transition: border-color 200ms cubic-bezier(0.22,1,0.36,1), box-shadow 200ms cubic-bezier(0.22,1,0.36,1);
  }
  .jams-email-input:hover,
  .jams-email-input:focus {
    border-color: #888;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
  }

  .jams-footer-submit {
    background: transparent;
    color: #111;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 500;
    border: 1px solid rgba(0,0,0,0.18);
    cursor: pointer;
    white-space: nowrap;
    font-family: inherit;
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.12s cubic-bezier(0.22,1,0.36,1), border-color 0.12s cubic-bezier(0.22,1,0.36,1);
  }
  .jams-footer-submit span {
    display: inline-block;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .jams-footer-submit:hover { background: rgba(0,0,0,0.05); border-color: rgba(0,0,0,0.28); }
  .jams-footer-submit:hover .btn-arrow { opacity: 1; transform: translateX(0); }
  .jams-footer-submit:hover span { transform: translateX(8px); }
  .jams-footer-submit .btn-arrow {
    position: absolute;
    left: 10px;
    width: 16px;
    height: 16px;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 200ms cubic-bezier(0.22, 1, 0.36, 1), transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
</style>

<script>
  const form    = document.getElementById('newsletter-form') as HTMLFormElement;
  const success = document.getElementById('newsletter-success') as HTMLElement;
  const error   = document.getElementById('newsletter-error') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;

    try {
      const res  = await fetch('/api/subscribe', { method: 'POST', body: new FormData(form) });
      const json = await res.json();
      if (json.ok) {
        form.style.display    = 'none';
        success.style.display = 'block';
      } else {
        error.style.display = 'block';
        btn.disabled = false;
      }
    } catch {
      error.style.display = 'block';
      btn.disabled = false;
    }
  });
</script>
